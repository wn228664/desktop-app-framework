# 构建时读取；修改后重启开发服务，或重新构建安装包。禁止填写秘密。
DESKTOP_API_BASE_URL=
# 逗号分隔的 HTTPS 下载 origin，例如 https://downloads.example.com
DESKTOP_DOWNLOAD_ORIGINS=
# electron-updater generic provider，生产环境必须使用 HTTPS。
DESKTOP_UPDATE_URL=
# 启用更新时必填：Windows 签名发布者，必须与真实证书身份一致。
DESKTOP_UPDATE_PUBLISHER=
# macOS 正式更新包需显式填写签名身份；留空时本地包不自动签名。
DESKTOP_MAC_SIGN_IDENTITY=
