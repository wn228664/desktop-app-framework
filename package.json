{
  "name": "desktop-app-framework",
  "version": "1.0.0",
  "private": true,
  "author": "Desktop Framework contributors",
  "license": "MIT",
  "description": "基于 Electron、Vue 和 JavaScript 的业务无关桌面应用框架，支持 macOS 与 Windows。",
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "prebuild": "node scripts/notices.js",
    "build": "electron-vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run format:check && npm test && npm run build",
    "pack:mac": "npm run build && electron-builder --mac --dir",
    "pack:win": "npm run build && electron-builder --win --dir",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@vitejs/plugin-vue": "6.0.10",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "element-plus": "2.14.7",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.0",
    "globals": "17.14.0",
    "pinia": "4.1.0",
    "prettier": "3.9.10",
    "vite": "8.3.5",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  }
}
